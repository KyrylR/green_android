CREATE TABLE IF NOT EXISTS `walletAbiTransactions` (
    `wallet_id` TEXT NOT NULL,
    `tx_hash` TEXT NOT NULL,
    `updated_at_ms` INTEGER NOT NULL,
    `record_json` TEXT NOT NULL,
     PRIMARY KEY(`wallet_id`, `tx_hash`),
     FOREIGN KEY(`wallet_id`)
     REFERENCES `wallet`(`id`) ON UPDATE NO ACTION ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS index_walletAbiTransactions_wallet_id_updated_at_ms
ON walletAbiTransactions(`wallet_id`, `updated_at_ms` DESC);

getWalletAbiTransactionRecords:
SELECT * FROM walletAbiTransactions
WHERE wallet_id = ?
ORDER BY updated_at_ms DESC, tx_hash DESC;

getWalletAbiTransactionRecord:
SELECT * FROM walletAbiTransactions
WHERE wallet_id = ? AND tx_hash = ?;

setWalletAbiTransactionRecord:
INSERT OR REPLACE INTO walletAbiTransactions(wallet_id, tx_hash, updated_at_ms, record_json)
VALUES (?, ?, ?, ?);

deleteWalletAbiTransactionRecord:
DELETE FROM walletAbiTransactions
WHERE wallet_id = ? AND tx_hash = ?;
